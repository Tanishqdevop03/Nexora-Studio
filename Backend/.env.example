PORT=5000

# Frontend URL(s) allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173

# Get it from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form enquiries are delivered (your Gmail)
CONTACT_TO_EMAIL=yourname@gmail.com

# Sender address. Without a verified domain, keep onboarding@resend.dev
# (it can only deliver to the email you signed up to Resend with).
CONTACT_FROM_EMAIL="Nexora Studio <onboarding@resend.dev>"

# Set to true only after verifying your own domain on Resend
SEND_AUTO_REPLY=false
